# Claude Code portable environment (UTF-8).
# scc.exe expands ${PORTABLE_ROOT} and variables defined earlier in this file.
# No inherited host PATH, Python home, package cache, or Claude config is used.

PATH=${PORTABLE_ROOT}\runtime\bin;${PORTABLE_ROOT}\runtime\venv\Scripts;${PORTABLE_ROOT}\runtime\uv;${PORTABLE_ROOT}\runtime\node;${PORTABLE_ROOT}\runtime\pwsh;${PORTABLE_ROOT}\runtime\git\cmd;${PORTABLE_ROOT}\runtime\git\bin;${PORTABLE_ROOT}\runtime\git\usr\bin;${SYSTEMROOT}\System32;${SYSTEMROOT}

CLAUDE_CONFIG_DIR=${PORTABLE_ROOT}\data\.claude
CLAUDE_CODE_GIT_BASH_PATH=${PORTABLE_ROOT}\runtime\git\bin\bash.exe
CLAUDE_CODE_GIT_BASH_PATH_TOOL=${PORTABLE_ROOT}\runtime\git\bin\bash.exe
CLAUDE_CODE_USE_POWERSHELL_TOOL=1
DISABLE_AUTOUPDATER=1

HOME=${PORTABLE_ROOT}\data\home
USERPROFILE=${PORTABLE_ROOT}\data\home
APPDATA=${PORTABLE_ROOT}\data\AppData\Roaming
LOCALAPPDATA=${PORTABLE_ROOT}\data\AppData\Local
XDG_CONFIG_HOME=${PORTABLE_ROOT}\data\home\.config
XDG_CACHE_HOME=${PORTABLE_ROOT}\data\cache
TEMP=${PORTABLE_ROOT}\data\tmp
TMP=${PORTABLE_ROOT}\data\tmp
TMPDIR=${PORTABLE_ROOT}\data\tmp

SHELL=${PORTABLE_ROOT}\runtime\git\bin\bash.exe
CHERE_INVOKING=1
MSYSTEM=MINGW64
GIT_CONFIG_GLOBAL=${HOME}\.gitconfig

VIRTUAL_ENV=${PORTABLE_ROOT}\runtime\venv
VIRTUAL_ENV_PROMPT=claude-portable
UV_PROJECT_ENVIRONMENT=${VIRTUAL_ENV}
UV_PYTHON_INSTALL_DIR=${PORTABLE_ROOT}\runtime\uv-python
UV_CACHE_DIR=${PORTABLE_ROOT}\data\cache\uv
UV_LINK_MODE=copy
UV_NO_CONFIG=1
UV_NO_MODIFY_PATH=1
PYTHONNOUSERSITE=1
PYTHONUTF8=1
PYTHONDONTWRITEBYTECODE=1
PIP_CACHE_DIR=${PORTABLE_ROOT}\data\cache\pip
PIP_CONFIG_FILE=${PORTABLE_ROOT}\config\pip.ini
PIP_DISABLE_PIP_VERSION_CHECK=1
PLAYWRIGHT_BROWSERS_PATH=${PORTABLE_ROOT}\runtime\ms-playwright

NPM_CONFIG_CACHE=${PORTABLE_ROOT}\data\cache\npm
NPM_CONFIG_PREFIX=${PORTABLE_ROOT}\runtime\node
NPM_CONFIG_USERCONFIG=${HOME}\.npmrc
NPM_CONFIG_UPDATE_NOTIFIER=false

POWERSHELL_TELEMETRY_OPTOUT=1
POWERSHELL_UPDATECHECK=Off
DOTNET_CLI_HOME=${HOME}
DOTNET_CLI_TELEMETRY_OPTOUT=1
PSModulePath=${HOME}\Documents\PowerShell\Modules;${PORTABLE_ROOT}\runtime\pwsh\Modules
